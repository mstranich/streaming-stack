TZ=America/Argentina/Buenos_Aires
PUID=1000
PGID=1000
UMASK=002

# Human-readable version tags validated on 2026-08-23. Update one service at a
# time following README.md; never change these to "latest" in production.
PYTHON_IMAGE=python:3.13.15-alpine3.24
TRANSMISSION_IMAGE=lscr.io/linuxserver/transmission:version-4.1.3-r0
PROWLARR_IMAGE=lscr.io/linuxserver/prowlarr:version-2.5.2.5491
FLARESOLVERR_IMAGE=ghcr.io/flaresolverr/flaresolverr:v3.5.0
SONARR_IMAGE=lscr.io/linuxserver/sonarr:version-4.0.19.2979
RADARR_IMAGE=lscr.io/linuxserver/radarr:version-6.3.0.10514
BAZARR_IMAGE=lscr.io/linuxserver/bazarr:version-v1.6.0
SEERR_IMAGE=ghcr.io/seerr-team/seerr:v3.4.1
JACKETT_IMAGE=lscr.io/linuxserver/jackett:version-v0.24.2489

LOG_MAX_SIZE=10m
LOG_MAX_FILES=3
MIN_FREE_SPACE_GB=20

# Shared Web credentials for *arr services.
SERVARR_USER=servarr
SERVARR_PASS=change-me-too
SERVARR_UI_LANGUAGE=es_MX

TRANSMISSION_USER=transmission
TRANSMISSION_PASS=change-me
TRANSMISSION_WEB_PORT=9091
TRANSMISSION_PEER_PORT=51413
TRANSMISSION_SEED_RATIO=2
# Native Transmission alternative-speed schedule. Normal speeds outside this
# interval remain under user control through the Web UI.
TRANSMISSION_WORK_SCHEDULE_ENABLED=true
TRANSMISSION_WORK_DAYS=mon,tue,wed,thu,fri
TRANSMISSION_WORK_START=09:00
TRANSMISSION_WORK_END=18:00
TRANSMISSION_WORK_DOWN_KBPS=512
TRANSMISSION_WORK_UP_KBPS=128

PROWLARR_WEB_PORT=9696
JACKETT_WEB_PORT=9117
# Comma-separated Jackett indexer IDs to expose to Prowlarr. Leave empty to
# reconcile every configured Jackett indexer that is not already native there.
JACKETT_SYNC_INDEXERS=
JACKETT_PROWLARR_TAG=jackett
# Empty selects the first App Profile returned by Prowlarr (normally Standard).
JACKETT_PROWLARR_APP_PROFILE=
JACKETT_INDEXER_TEST_TIMEOUT=120
JACKETT_FLARESOLVERR_MAX_TIMEOUT=60000
SONARR_WEB_PORT=8989
RADARR_WEB_PORT=7878
BAZARR_WEB_PORT=6767
SEERR_WEB_PORT=5055
SEERR_LAN_LISTEN_ADDRESS=192.168.1.2
SEERR_LAN_HOSTNAMES=raptorbox-z790
SEERR_LAN_ALLOWED_REMOTES=192.168.1.0/24

# Internal-only anti-bot proxy used by Prowlarr indexers.
FLARESOLVERR_LOG_LEVEL=info
FLARESOLVERR_LOG_HTML=false
FLARESOLVERR_TAG=flaresolver
FLARESOLVERR_REQUEST_TIMEOUT=60

# Jellyfin runs on Windows; Bazarr reaches it through Rancher's host gateway.
JELLYFIN_HOST=host.docker.internal
JELLYFIN_PORT=8096
JELLYFIN_API_KEY=

# Seerr uses ./config/seerr for SQLite and a dedicated API key.
SEERR_API_KEY=generate-a-64-character-random-secret
SEERR_LOG_LEVEL=info
SEERR_UI_LANGUAGE=es
SEERR_APPLICATION_TITLE=Seerr
SEERR_JELLYFIN_INTERNAL_URL=http://host.docker.internal:8096
SEERR_JELLYFIN_EXTERNAL_URL=http://192.168.1.2:8096
# Empty selects the first quality profile returned by each service.
SEERR_RADARR_PROFILE=
SEERR_SONARR_PROFILE=
# Optional native Telegram notifications. A type mask of 0 enables every
# notification type. Keep the bot token only in the ignored .env file.
SEERR_TELEGRAM_BOT_TOKEN=
SEERR_TELEGRAM_CHAT_ID=
SEERR_TELEGRAM_TYPES=0
# Only required when the destination is a topic in a Telegram forum group.
SEERR_TELEGRAM_MESSAGE_THREAD_ID=
SEERR_TELEGRAM_SEND_SILENTLY=false
SEERR_TELEGRAM_EMBED_POSTER=true
