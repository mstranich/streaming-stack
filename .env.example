TZ=America/Argentina/Buenos_Aires
PUID=1000
PGID=1000
UMASK=002

# Human-readable version tags validated on 2026-08-23. Update one service at a
# time following README.md; never change these to "latest" in production.
PYTHON_IMAGE=python:3.13.15-alpine3.24
TRANSMISSION_IMAGE=lscr.io/linuxserver/transmission:version-4.1.3-r0
PROWLARR_IMAGE=lscr.io/linuxserver/prowlarr:version-2.5.2.5491
SONARR_IMAGE=lscr.io/linuxserver/sonarr:version-4.0.19.2979
RADARR_IMAGE=lscr.io/linuxserver/radarr:version-6.3.0.10514
BAZARR_IMAGE=lscr.io/linuxserver/bazarr:version-v1.6.0

LOG_MAX_SIZE=10m
LOG_MAX_FILES=3
MIN_FREE_SPACE_GB=20

# Shared Web credentials for *arr services.
SERVARR_USER=servarr
SERVARR_PASS=change-me-too
SERVARR_UI_LANGUAGE=es_MX

TRANSMISSION_USER=transmission
TRANSMISSION_PASS=change-me
TRANSMISSION_WEB_PORT=9091
TRANSMISSION_PEER_PORT=51413

PROWLARR_WEB_PORT=9696
SONARR_WEB_PORT=8989
RADARR_WEB_PORT=7878
BAZARR_WEB_PORT=6767

# Jellyfin runs on Windows; Bazarr reaches it through Rancher's host gateway.
JELLYFIN_HOST=host.docker.internal
JELLYFIN_PORT=8096
JELLYFIN_API_KEY=
